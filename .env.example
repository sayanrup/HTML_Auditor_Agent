## LLM runtime configuration (required for audits)
#
# Choose one:
# - openai
# - anthropic
# - google
LLM_PROVIDER=openai

# Provider API key
LLM_API_KEY=your_api_key_here

# Optional model override
# OpenAI: gpt-4o-mini, gpt-4.1-mini, ...
# Anthropic: claude-3-5-sonnet-latest, ...
# Google: gemini-1.5-flash, gemini-1.5-pro, ...
LLM_MODEL=gpt-4o-mini

# Optional base URL (useful for OpenAI-compatible servers or proxies)
# LLM_BASE_URL=https://api.openai.com/v1

# Public SCM link shown in the app Info dialog (server-side; read by Node)
# SCM_REPO_URL=https://github.com/org/repo

# Optional: same URL for the Vite client bundle (must be VITE_ — regular SCM_REPO_URL is NOT visible in React)
# VITE_SCM_REPO_URL=https://github.com/org/repo

# Local repo where “Apply & push” writes HTML fixes (default: ../dir-impcat-nodejs from project root)
# DIR_REPO_PATH=C:\path\to\dir-impcat-nodejs
# DIR_GIT_REMOTE=origin
# Branch to create html-audit-suggestion from (default: stage)
# DIR_BASE_BRANCH=stage

# After a normal push fails (remote branch exists, non-fast-forward), retry with --force-with-lease (default: true)
# DIR_PUSH_FORCE_WITH_LEASE=false
